# kit.conf — el ÚNICO fichero que el kit necesita de tu proyecto.
#
# Lo lee `verifica.sh` del plugin. Define tres cosas: qué significa "verificado" aquí, dónde
# vive el código Swift, y qué NO cubre tu firma.

# Dónde buscar duplicados. Directorios, separados por espacios.
FUENTES="App Packages"

# Qué NO cubre tu firma. OPCIONAL, en prosa, dos o tres líneas — no un ensayo. Lo que escribas
# aquí viaja EN la firma: el informe lo imprime y `/kit-estado` dice que está declarado. Si no
# lo declaras, el informe lo dice, que es mejor que dejar creer que no hay límites.
#
# Escribe lo que tu verificación local no puede ver, no lo que te gustaría tener. El caso
# típico: el CI compila con otro Xcode, y un diagnóstico que solo produce esa versión no lo
# ve ninguna firma local.
LIMITES="- El CI compila con otro Xcode que esta máquina: lo que solo falla ahí no lo ve esta firma.
- Los tests de UI quedan fuera: tardan minutos y van en CI."

# Qué hay que ejecutar para dar el proyecto por verificado. Cada `paso` lleva un nombre
# legible y un comando; si alguno sale distinto de 0, no hay firma.
verificaciones() {
    paso "Platform · build"  bash -c 'cd Packages/Platform && swift build'
    paso "Platform · tests"  bash -c 'cd Packages/Platform && swift test'
    paso "Features · build"  bash -c 'cd Packages/Features && swift build'
    paso "Features · tests"  bash -c 'cd Packages/Features && swift test'

    # Un proyecto de un solo módulo suele necesitar solo esto:
    # paso "build"  swift build
    # paso "tests"  swift test

    # LO QUE VIVE FUERA DE LOS PAQUETES SPM NO SE VERIFICA SI NO LO PONES AQUÍ.
    #
    # Un proyecto iOS típico tiene targets de Xcode —la app, sus tests unitarios, los de
    # snapshot, los de UI— que `swift build` NO toca. Si no los nombras, la firma dice
    # "verificado" sobre un árbol donde esos ficheros no se han ni compilado.
    #
    # Encadena build y tests con `&&` en UN SOLO paso: separados, un build en rojo deja al
    # segundo corriendo contra el bundle anterior y estampando un ✅ sobre artefactos
    # viejos. Un informe con un verde falso dentro es peor que uno todo rojo.
    #
    # paso "app · build + tests" bash -c '
    #     set -e
    #     D="platform=iOS Simulator,name=iPhone 17"
    #     xcodebuild build-for-testing -project MiApp.xcodeproj -scheme MiApp \
    #         -destination "$D" CODE_SIGNING_ALLOWED=NO -quiet
    #     xcodebuild test-without-building -project MiApp.xcodeproj -scheme MiApp \
    #         -destination "$D" -only-testing:MiAppTests CODE_SIGNING_ALLOWED=NO -quiet'
    #
    # Los UI tests suelen quedarse fuera (arrancan simulador, tardan minutos): van en CI.
    # Cuando dejes algo fuera, ponlo en `LIMITES`, arriba — no en un comentario como este: un
    # comentario no viaja a la firma, y alguien creerá que un cambio de UI está cubierto.
}
